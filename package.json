{
  "name": "passist",
  "description": "passing siteswap assistant",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "devwidget": "NODE_ENV=development yarn run build:api",
    "build": "vite build && yarn run build:api",
    "build:causal_diagram_widget": "BUILD_TARGET=causal_diagram_widget vite build -c vite.api.config.js",
    "build:animation_widget": "BUILD_TARGET=animation_widget vite build -c vite.api.config.js",
    "build:api": "yarn run build:causal_diagram_widget && yarn run build:animation_widget",
    "preview": "vite preview",
    "start": "node bin/server.js",
    "test": "uvu tests",
    "check": "svelte-check"
  },
  "dependencies": {
    "express": "^5.2.1",
    "marked": "^17.0.1",
    "peggy": "^5.0.6",
    "three": "^0.154.0",
    "vite": "^7.3.1"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@sveltejs/adapter-node": "5.5.1",
    "@sveltejs/kit": "2.50.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.3",
    "svelte": "5.48.0",
    "svelte-check": "^4.3.5",
    "typescript": "^5.9.3",
    "uvu": "^0.5.6"
  }
}
