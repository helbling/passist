{
  "name": "passist",
  "description": "passing siteswap assistant",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "devwidget": "NODE_ENV=development npm run build:api",
    "build": "vite build && npm run build:api",
    "build:causal_diagram_widget": "BUILD_TARGET=causal_diagram_widget vite build -c vite.api.config.js",
    "build:animation_widget": "BUILD_TARGET=animation_widget vite build -c vite.api.config.js",
    "build:api": "npm run build:causal_diagram_widget && npm run build:animation_widget",
    "preview": "vite preview",
    "start": "node bin/server.js",
    "test": "uvu tests",
    "lint": "eslint"
  },
  "dependencies": {
    "express": "^5.1.0",
    "heap-js": "^2.6.0",
    "marked": "^16.0.0",
    "peggy": "^5.0.4",
    "three": "^0.154.0",
    "vite": "^6.2.6"
  },
  "devDependencies": {
    "eslint": "^9.30.0",
    "npm-run-all": "^4.1.5",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "svelte": "5.34.9",
    "@sveltejs/adapter-node": "5.2.12",
    "@sveltejs/kit": "2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "uvu": "^0.5.6"
  }
}
